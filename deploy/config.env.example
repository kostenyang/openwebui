# ─────────────────────────────────────────────────────────────────────
# Open WebUI customer-site deploy config
# 拷貝成 config.env 後修改。所有 *_KEY 留空 = 跳過該步驟。
# ─────────────────────────────────────────────────────────────────────

# ─── [1] 主機網路設定(選擇性) ────────────────────────────────────────
# 想用 DHCP 就把 STATIC_IP 留空。設了就改 netplan + hostname。
STATIC_IP=""                    # e.g. 10.0.0.64/23
GATEWAY=""                      # e.g. 10.0.0.1
DNS_SERVERS=""                  # e.g. 10.0.0.1,8.8.8.8
DNS_SEARCH=""                   # e.g. home.lab
HOSTNAME=""                     # e.g. openwebui.home.lab
NIC=""                          # e.g. ens160 (留空自動偵測)

# ─── [2] Open WebUI 基本設定 ─────────────────────────────────────────
WEBUI_NAME="Open WebUI"
OPENWEBUI_PORT=3000
INSTALL_DIR=/opt/open-webui

# ─── [3] mcpo (MCP→OpenAPI proxy)(選擇性) ──────────────────────────
# 想接 MCP server 才需要設這段。MCPO_ENABLED=false 則跳過。
MCPO_ENABLED=true
MCPO_PORT=8000
MCPO_API_KEY="openwebui-mcpo-secret"     # Open WebUI 端要送的 Bearer

# 上游 MCP server。多個就照樣加在 install.sh 生 mcpo-config.json 那段
UPSTREAM_MCP_NAME="vcf-lab"              # 在 mcpo 路徑上會出現
UPSTREAM_MCP_TYPE="sse"                  # sse | streamable_http
UPSTREAM_MCP_URL=""                      # e.g. https://10.0.0.65:7000/sse
UPSTREAM_MCP_BEARER=""                   # 上游 MCP 的 token
UPSTREAM_MCP_CERT_FILE=""                # 自簽 cert 路徑(同機本地檔)留空=不掛

# ─── [4] LLM providers(填一家就裝一家;全空 = 都不裝) ───────────────
# OpenAI(原生)
OPENAI_API_KEY=""                # sk-...
OPENAI_API_BASE="https://api.openai.com/v1"

# Google Gemini(走 OpenAI-compatible 端點)
GEMINI_API_KEY=""                # AIza...

# Anthropic Claude(走 Open WebUI Function)
ANTHROPIC_API_KEY=""             # sk-ant-...
